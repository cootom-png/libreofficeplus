<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibreOfficePlus · 界面配置" Width="860" Height="800" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" UseLayoutRounding="True"
        Background="#F0F4F9" Foreground="#1F1F1F" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#0B57D0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="24,10"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="22"
                    Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#7CACF8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TonalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#D3E3FD"/><Setter Property="Foreground" Value="#041E49"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ModuleCard" Background="#F8FAFD" BorderBrush="#E3E3E3" BorderThickness="1"
                    CornerRadius="12" Padding="12,14" Margin="0,0,8,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CheckSurface" Width="18" Height="18" BorderBrush="#747775" BorderThickness="2" CornerRadius="3" VerticalAlignment="Center">
                  <Path x:Name="CheckMark" Data="M 2,7 L 6,11 L 13,3" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ModuleCard" Property="Background" Value="#E8F0FE"/>
                <Setter TargetName="ModuleCard" Property="BorderBrush" Value="#A8C7FA"/>
                <Setter TargetName="CheckSurface" Property="Background" Value="#0B57D0"/>
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#0B57D0"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModuleCard" Property="BorderBrush" Value="#0B57D0"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModuleCard" Property="BorderBrush" Value="#0B57D0"/><Setter TargetName="ModuleCard" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModuleCard" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#C4C7C5"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="SelectionBrush" Value="#A8C7FA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="FieldSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldSurface" Property="BorderBrush" Value="#0B57D0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#747775"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F0F4F9">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
    <Grid Margin="32,24,32,22">
      <StackPanel Margin="0,0,70,0">
        <TextBlock Text="LibreOfficePlus" Foreground="#0B57D0" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock x:Name="Heading" Text="熟悉的操作，清爽的外观" FontSize="28" Margin="0,8,0,8"/>
        <TextBlock x:Name="Subtitle" Text="WPS 操作布局 · Material 浅色风格 · 可恢复的本地配置" Foreground="#444746" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D3E3FD" CornerRadius="14" Padding="12,6">
        <TextBlock x:Name="VersionLabel" Foreground="#041E49" FontSize="12"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Margin="24,0" Padding="24,22" Background="White" CornerRadius="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
          <StackPanel x:Name="SelectionPanel" Margin="0,0,0,18">
            <TextBlock x:Name="ModuleHeading" Text="选择要配置的模块" FontSize="16" Margin="0,0,0,14"/>
            <UniformGrid Columns="4">
              <CheckBox x:Name="ModuleWriter" AutomationProperties.Name="Writer 文字"><StackPanel><TextBlock Text="Writer" FontWeight="SemiBold"/><TextBlock Text="文字" Foreground="#444746" FontSize="12" Margin="0,3,0,0"/></StackPanel></CheckBox>
              <CheckBox x:Name="ModuleCalc" AutomationProperties.Name="Calc 表格"><StackPanel><TextBlock Text="Calc" FontWeight="SemiBold"/><TextBlock Text="表格" Foreground="#444746" FontSize="12" Margin="0,3,0,0"/></StackPanel></CheckBox>
              <CheckBox x:Name="ModuleDraw" AutomationProperties.Name="Draw 绘图"><StackPanel><TextBlock Text="Draw" FontWeight="SemiBold"/><TextBlock Text="绘图" Foreground="#444746" FontSize="12" Margin="0,3,0,0"/></StackPanel></CheckBox>
              <CheckBox x:Name="ModuleImpress" AutomationProperties.Name="Impress 演示"><StackPanel><TextBlock Text="Impress" FontWeight="SemiBold"/><TextBlock Text="演示" Foreground="#444746" FontSize="12" Margin="0,3,0,0"/></StackPanel></CheckBox>
            </UniformGrid>
            <TextBlock Text="LibreOffice 安装目录" Foreground="#444746" FontSize="12" Margin="0,14,0,8"/>
            <TextBox x:Name="ApplicationPath" AutomationProperties.Name="LibreOffice 安装目录"/>
            <TextBlock x:Name="FontNotice" Foreground="#444746" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19"/>
            <Border Background="#F0F4F9" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
              <TextBlock Text="通用外观在所有组件间共享。安装后关闭官方升级提醒、自动下载和自动更新，由兼容升级入口管理；全部恢复后还原原设置。" Foreground="#444746" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <Grid>
              <TextBlock x:Name="StatusTitle" Text="准备配置" FontSize="20"/>
              <TextBlock x:Name="Percent" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#0B57D0" FontSize="16"/>
            </Grid>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,18" Minimum="0" Maximum="100" Foreground="#0B57D0" Background="#D3E3FD" BorderThickness="0">
              <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
            <UniformGrid Columns="3" Margin="0,0,0,16">
              <TextBlock x:Name="Step1" Text="01  检查环境" Foreground="#0B57D0" FontSize="12"/>
              <TextBlock x:Name="Step2" Text="02  备份与配置" Foreground="#747775" FontSize="12" HorizontalAlignment="Center"/>
              <TextBlock x:Name="Step3" Text="03  完成与整理" Foreground="#747775" FontSize="12" HorizontalAlignment="Right"/>
            </UniformGrid>
          </StackPanel>
          <TextBlock x:Name="StatusMessage" Text="选好模块后，点击“开始配置”。" Foreground="#444746" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="21"/>
          <ItemsControl x:Name="Checks" Visibility="Collapsed" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="0,12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,2,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#444746" FontSize="12" LineHeight="20" Margin="0,0,12,0"/>
                    <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="12" Padding="6,4">
                      <Border.Style>
                        <Style TargetType="Border"><Setter Property="Background" Value="#F0F4F9"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="通过"><Setter Property="Background" Value="#C4EED0"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="需处理"><Setter Property="Background" Value="#F9DEDC"/></DataTrigger></Style.Triggers></Style>
                      </Border.Style>
                      <TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="#F8FAFD" CornerRadius="12" Padding="16,12" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Details" Text="保留熟悉的功能分组与快捷键，统一浅色外观。&#xA;首次备份将保留，可随时恢复原界面。" Foreground="#444746" FontSize="12" TextWrapping="Wrap" LineHeight="22"/></ScrollViewer>
          </Border>
          <Button x:Name="TemplatesButton" Content="查看新文档模板" Style="{StaticResource TonalButton}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          <WrapPanel Margin="0,16,0,0">
            <Button x:Name="UpgradeButton" Content="兼容升级" Style="{StaticResource TonalButton}" Padding="18,8" Margin="0,0,10,8"/>
            <Button x:Name="PackageButton" Content="获取新版配置包" Background="#F0F4F9" Foreground="#0B57D0" Padding="18,8" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="32,0">
      <TextBlock x:Name="Footer" Text="本地配置 · 首次备份保留" Foreground="#444746" VerticalAlignment="Center" FontSize="12" MaxWidth="260" HorizontalAlignment="Left" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="CloseButton" Content="取消" Background="Transparent" Foreground="#0B57D0" Margin="0,0,8,0"/>
        <Button x:Name="StartButton" Content="开始配置"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
