<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibreOfficePlus · 界面配置" Width="720" Height="570"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F4F7FB" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="26,11"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F4F7FB">
    <Grid.RowDefinitions><RowDefinition Height="166"/><RowDefinition/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172C51" Offset="0"/><GradientStop Color="#245FE4" Offset="1"/></LinearGradientBrush>
      </Border.Background>
      <Grid Margin="32,22">
        <StackPanel>
          <TextBlock Text="LibreOfficePlus" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="Heading" Text="让办公，回到熟悉的节奏" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,15,0,8"/>
          <TextBlock x:Name="Subtitle" Text="WPS 习惯适配 · 为文字、表格与绘图配置熟悉的界面" Foreground="#D7E5FF" FontSize="12"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#30FFFFFF" CornerRadius="11" Padding="10,4"><TextBlock Text="v6" Foreground="White" FontSize="11"/></Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="24,-12,24,0" Padding="24,22" Background="White" CornerRadius="14" BorderBrush="#E3EAF4" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
          <TextBlock x:Name="StatusTitle" Text="正在准备安装" FontSize="18" FontWeight="SemiBold" Foreground="#172C51"/>
          <TextBlock x:Name="Percent" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#2563EB" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="10" Margin="0,18,0,14" Minimum="0" Maximum="100" Foreground="#2563EB" Background="#EAF0FA" BorderThickness="0">
          <ProgressBar.Template>
            <ControlTemplate TargetType="ProgressBar">
              <Grid x:Name="PART_Track">
                <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
              </Grid>
            </ControlTemplate>
          </ProgressBar.Template>
        </ProgressBar>
        <TextBlock x:Name="StatusMessage" Grid.Row="2" Text="正在启动配置程序…" Foreground="#52637E" FontSize="12" TextWrapping="Wrap" MinHeight="36"/>
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,14,0,18">
          <TextBlock x:Name="Step1" Text="01  检查环境" Foreground="#2563EB" FontSize="12"/>
          <TextBlock x:Name="Step2" Text="02  备份与配置" Foreground="#8795A9" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock x:Name="Step3" Text="03  完成与整理" Foreground="#8795A9" FontSize="12" HorizontalAlignment="Right"/>
        </UniformGrid>
        <Border Grid.Row="4" Background="#F5F8FD" CornerRadius="9" Padding="14,12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Details" Text="适用模块：Writer 文字 / Calc 表格 / Draw 绘图&#xA;首次备份将妥善保留，可随时恢复原界面。" Foreground="#52637E" FontSize="12" TextWrapping="Wrap" LineHeight="23"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="32,0">
      <TextBlock x:Name="Footer" Text="本地配置 · 保留首次备份" Foreground="#8795A9" VerticalAlignment="Center" FontSize="11"/>
      <Button x:Name="CloseButton" Content="正在配置…" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
    </Grid>
  </Grid>
</Window>
