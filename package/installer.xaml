<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibreOfficePlus · 界面配置" Width="780" Height="760" MinWidth="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F4F7FB" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="26,11"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#8DB5FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F4F7FB">
    <Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172C51" Offset="0"/><GradientStop Color="#245FE4" Offset="1"/></LinearGradientBrush>
      </Border.Background>
      <Grid Margin="32,22">
        <StackPanel>
          <TextBlock Text="LibreOfficePlus" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="Heading" Text="让办公，回到熟悉的节奏" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,15,0,8"/>
          <TextBlock x:Name="Subtitle" Text="文字 · 表格 · 绘图 · 演示，常用操作更容易找到" Foreground="#D7E5FF" FontSize="12"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#30FFFFFF" CornerRadius="11" Padding="10,4"><TextBlock x:Name="VersionLabel" Foreground="White" FontSize="11"/></Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="24,-12,24,0" Padding="24,22" Background="White" CornerRadius="14" BorderBrush="#E3EAF4" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <StackPanel x:Name="SelectionPanel" Margin="0,0,0,20">
          <TextBlock x:Name="ModuleHeading" Text="选择要配置的模块" FontSize="14" FontWeight="SemiBold" Foreground="#172C51"/>
          <WrapPanel Margin="0,12,0,14">
            <CheckBox x:Name="ModuleWriter" Content="Writer 文字" Margin="0,0,24,8"/>
            <CheckBox x:Name="ModuleCalc" Content="Calc 表格" Margin="0,0,24,8"/>
            <CheckBox x:Name="ModuleDraw" Content="Draw 绘图" Margin="0,0,24,8"/>
            <CheckBox x:Name="ModuleImpress" Content="Impress 演示" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock Text="LibreOffice 安装目录" Foreground="#52637E" FontSize="12" Margin="0,0,0,6"/>
          <TextBox x:Name="ApplicationPath" Padding="8,6" BorderBrush="#D7E1EE"/>
          <TextBlock x:Name="FontNotice" Foreground="#52637E" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
          <TextBlock Text="安装后关闭 LibreOffice 升级提醒、自动下载和自动更新；通过兼容升级入口更新。全部恢复后还原原设置。" Foreground="#52637E" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid>
          <TextBlock x:Name="StatusTitle" Text="准备配置" FontSize="18" FontWeight="SemiBold" Foreground="#172C51"/>
          <TextBlock x:Name="Percent" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#2563EB" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
        <ProgressBar x:Name="Progress" Height="10" Margin="0,18,0,14" Minimum="0" Maximum="100" Foreground="#2563EB" Background="#EAF0FA" BorderThickness="0">
          <ProgressBar.Template>
            <ControlTemplate TargetType="ProgressBar">
              <Grid x:Name="PART_Track">
                <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
              </Grid>
            </ControlTemplate>
          </ProgressBar.Template>
        </ProgressBar>
        <TextBlock x:Name="StatusMessage" Text="选择模块后点击“开始配置”，环境检查结果会逐项显示。" Foreground="#52637E" FontSize="12" TextWrapping="Wrap" MinHeight="36"/>
        <UniformGrid Columns="3" Margin="0,8,0,12">
          <TextBlock x:Name="Step1" Text="01  检查环境" Foreground="#2563EB" FontSize="12"/>
          <TextBlock x:Name="Step2" Text="02  备份与配置" Foreground="#8795A9" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock x:Name="Step3" Text="03  完成与整理" Foreground="#8795A9" FontSize="12" HorizontalAlignment="Right"/>
        </UniformGrid>
          <ItemsControl x:Name="Checks" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#EAF0FA" BorderThickness="0,0,0,1" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" Foreground="#172C51" FontSize="12" FontWeight="SemiBold" Margin="0,1,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#52637E" FontSize="12" LineHeight="19" Margin="0,0,12,0"/>
                    <Border Grid.Column="2" VerticalAlignment="Top" Background="#F5F8FD" CornerRadius="6" Padding="5,3">
                      <TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        <Border Background="#F5F8FD" CornerRadius="9" Padding="14,10" MaxHeight="110">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Details" Text="适用模块：Writer 文字 / Calc 表格 / Draw 绘图 / Impress 演示&#xA;首次备份将妥善保留，可随时恢复原界面。" Foreground="#52637E" FontSize="12" TextWrapping="Wrap" LineHeight="23"/>
          </ScrollViewer>
        </Border>
        <Button x:Name="TemplatesButton" Content="查看新文档模板" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0" FontSize="12"/>
        <WrapPanel Margin="0,12,0,0">
          <Button x:Name="UpgradeButton" Content="兼容升级" FontSize="12" Padding="18,8" Margin="0,0,10,8"/>
          <Button x:Name="PackageButton" Content="获取新版配置包" Background="#E3EAF4" Foreground="#172C51" FontSize="12" Padding="18,8" Margin="0,0,0,8"/>
        </WrapPanel>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="32,0">
      <TextBlock x:Name="Footer" Text="本地配置 · 保留首次备份" Foreground="#8795A9" VerticalAlignment="Center" FontSize="11" MaxWidth="260" HorizontalAlignment="Left" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="CloseButton" Content="取消" Background="#E3EAF4" Foreground="#172C51" FontSize="12" Margin="0,0,10,0"/>
        <Button x:Name="StartButton" Content="开始配置" FontSize="12"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
