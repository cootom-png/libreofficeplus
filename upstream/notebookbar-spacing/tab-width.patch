+++ b/vcl/qa/cppunit/notebookbar.cxx
@@ -0,0 +1,161 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <sal/config.h>
+#include <test/bootstrapfixture.hxx>
+#include <vcl/font.hxx>
+#include <vcl/tabctrl.hxx>
+#include <vcl/toolbox.hxx>
+#include <vcl/wrkwin.hxx>
+
+#include <array>
+
+namespace
+{
+class MeasuringTabControl final : public TabControl
+{
+public:
+    explicit MeasuringTabControl(vcl::Window* pParent)
+        : TabControl(pParent)
+    {
+    }
+
+    bool placeTabs(tools::Long nWidth) { return ImplPlaceTabs(nWidth); }
+};
+
+class MeasuringNotebookbar final : public NotebookbarTabControlBase
+{
+public:
+    explicit MeasuringNotebookbar(vcl::Window* pParent)
+        : NotebookbarTabControlBase(pParent)
+    {
+    }
+
+    bool placeTabs(tools::Long nWidth)
+    {
+        calculateRequisition();
+        return ImplPlaceTabs(nWidth);
+    }
+};
+}
+
+class NotebookbarTest : public test::BootstrapFixture
+{
+public:
+    NotebookbarTest()
+        : BootstrapFixture(true, false)
+    {
+    }
+
+    void testTextWidths();
+    void testResizeWithShortcuts();
+    void testHiddenTabWidths();
+
+    CPPUNIT_TEST_SUITE(NotebookbarTest);
+    CPPUNIT_TEST(testTextWidths);
+    CPPUNIT_TEST(testResizeWithShortcuts);
+    CPPUNIT_TEST(testHiddenTabWidths);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+void NotebookbarTest::testTextWidths()
+{
+    ScopedVclPtrInstance<WorkWindow> xWindow(nullptr, WB_APP);
+    ScopedVclPtrInstance<MeasuringTabControl> xReference(xWindow.get());
+    ScopedVclPtrInstance<MeasuringNotebookbar> xNotebookbar(xWindow.get());
+    const std::array<OUString, 4> aLabels
+        = { u"开始"_ustr, u"Insert"_ustr, u"Formatting and editing tools"_ustr, u""_ustr };
+    for (sal_uInt16 nPage = 1; nPage <= aLabels.size(); ++nPage)
+    {
+        xReference->InsertPage(nPage, aLabels[nPage - 1]);
+        xNotebookbar->InsertPage(nPage, aLabels[nPage - 1]);
+    }
+
+    // Use the normal tab measurement as the oracle, including native padding.
+    // Vary the font size without assuming a particular system font or DPI.
+    for (tools::Long nHeight : { 10, 16, 24 })
+    {
+        vcl::Font aFont;
+        aFont.SetFontSize(Size(0, nHeight));
+        xReference->SetControlFont(aFont);
+        xNotebookbar->SetControlFont(aFont);
+        CPPUNIT_ASSERT(xReference->placeTabs(8192));
+        CPPUNIT_ASSERT(xNotebookbar->placeTabs(8192));
+        if (nHeight == 10)
+            CPPUNIT_ASSERT(xReference->GetTabBounds(2).GetWidth() < 100);
+        for (sal_uInt16 nPage = 1; nPage <= aLabels.size(); ++nPage)
+        {
+            CPPUNIT_ASSERT_EQUAL(xReference->GetTabBounds(nPage).GetWidth(),
+                                 xNotebookbar->GetTabBounds(nPage).GetWidth());
+        }
+    }
+}
+
+void NotebookbarTest::testResizeWithShortcuts()
+{
+    ScopedVclPtrInstance<WorkWindow> xWindow(nullptr, WB_APP);
+    ScopedVclPtrInstance<MeasuringNotebookbar> xNotebookbar(xWindow.get());
+    ScopedVclPtrInstance<ToolBox> xShortcuts(xNotebookbar.get());
+    vcl::Font aFont;
+    aFont.SetFontSize(Size(0, 10));
+    xNotebookbar->SetControlFont(aFont);
+    xShortcuts->SetSizePixel(Size(120, 24));
+    xNotebookbar->SetToolBox(xShortcuts.get());
+    for (sal_uInt16 nPage = 1; nPage <= 3; ++nPage)
+        xNotebookbar->InsertPage(nPage, u"Tab"_ustr);
+
+    // Cross the old 100-pixel-per-tab threshold while all natural widths fit.
+    const tools::Long nThreshold = 3 * 100 + xShortcuts->GetSizePixel().Width() + 1
+                                  + xNotebookbar->GetOpenMenu()->GetSizePixel().Width();
+    CPPUNIT_ASSERT(xNotebookbar->placeTabs(nThreshold - 1));
+    const tools::Long nWidth = xNotebookbar->GetTabBounds(1).GetWidth();
+    CPPUNIT_ASSERT(nWidth < 100);
+    CPPUNIT_ASSERT(xNotebookbar->placeTabs(nThreshold + 1));
+    for (sal_uInt16 nPage = 1; nPage <= 3; ++nPage)
+        CPPUNIT_ASSERT_EQUAL(nWidth, xNotebookbar->GetTabBounds(nPage).GetWidth());
+
+    CPPUNIT_ASSERT(xNotebookbar->GetTabBounds(1).Left()
+                   > xShortcuts->GetPosPixel().X() + xShortcuts->GetSizePixel().Width());
+    CPPUNIT_ASSERT(xNotebookbar->GetTabBounds(3).Right()
+                   < xNotebookbar->GetOpenMenu()->GetPosPixel().X());
+}
+
+void NotebookbarTest::testHiddenTabWidths()
+{
+    ScopedVclPtrInstance<WorkWindow> xWindow(nullptr, WB_APP);
+    ScopedVclPtrInstance<MeasuringNotebookbar> xNotebookbar(xWindow.get());
+    vcl::Font aFont;
+    aFont.SetFontSize(Size(0, 10));
+    xNotebookbar->SetControlFont(aFont);
+    for (sal_uInt16 nPage = 1; nPage <= 3; ++nPage)
+        xNotebookbar->InsertPage(nPage, u"Tab"_ustr);
+    xNotebookbar->SetCurPageId(1);
+
+    // Hiding a contextual tab must not expand the remaining tabs to 100 pixels.
+    const tools::Long nWidth = 250 + xNotebookbar->GetOpenMenu()->GetSizePixel().Width();
+    CPPUNIT_ASSERT(xNotebookbar->placeTabs(nWidth));
+    const tools::Long nTabWidth = xNotebookbar->GetTabBounds(1).GetWidth();
+    CPPUNIT_ASSERT(nTabWidth < 100);
+    xNotebookbar->SetPageVisible(3, false);
+    CPPUNIT_ASSERT(xNotebookbar->placeTabs(nWidth));
+    CPPUNIT_ASSERT(xNotebookbar->GetTabBounds(3).IsEmpty());
+    CPPUNIT_ASSERT_EQUAL(nTabWidth, xNotebookbar->GetTabBounds(1).GetWidth());
+    CPPUNIT_ASSERT_EQUAL(nTabWidth, xNotebookbar->GetTabBounds(2).GetWidth());
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(1), xNotebookbar->GetCurPageId());
+
+    xNotebookbar->SetPageVisible(3, true);
+    CPPUNIT_ASSERT(xNotebookbar->placeTabs(nWidth));
+    CPPUNIT_ASSERT_EQUAL(nTabWidth, xNotebookbar->GetTabBounds(3).GetWidth());
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(3), xNotebookbar->GetPageCount());
+}
+
+CPPUNIT_TEST_SUITE_REGISTRATION(NotebookbarTest);
+CPPUNIT_PLUGIN_IMPLEMENT();
+
